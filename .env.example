# Fit AI Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (optional - app automatically uses persistent local storage if offline)
MONGODB_URI=mongodb://127.0.0.1:27017/fit_ai

# Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Google Gemini API Key for AI Coaching (optional - falls back to deterministic expert coach engine)
GEMINI_API_KEY=

# Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173
